# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://risk_user:risk_pass@postgres:5432/risk_db
DATABASE_URL_SYNC=postgresql://risk_user:risk_pass@postgres:5432/risk_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── RabbitMQ (Celery broker) ─────────────────────────────────────────────────
RABBITMQ_URL=amqp://risk_user:risk_pass@rabbitmq:5672/

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://risk_user:risk_pass@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Razorpay (sandbox) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_CHANGEME
RAZORPAY_KEY_SECRET=CHANGEME

# ── LLM (Anthropic Claude) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGEME

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=CHANGEME_USE_LONG_RANDOM_STRING
